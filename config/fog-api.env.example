# Copy to /etc/jog/fog-api.env (root:root, mode 0600). Read by jog-imaging-api (live imaging view).
# Never commit the real file. In the FOG web UI: Settings > API System (enable the API, copy the system token),
# then Users > <a dedicated read-only user> > API Token. Use a dedicated account with the lowest rights that can
# list tasks, not an administrator.
JOG_FOG_API_URL=http://localhost/fog
FOG_API_TOKEN=
FOG_USER_TOKEN=
