# /etc/jog/mobile-api.env — root:root, mode 0600. Never commit the real file.
# Read by jog-mobile-api.service (systemd hands it a private copy).

# Generate with: openssl rand -hex 32
JOG_MOBILE_TOKEN=

# Bind to the hidden JOGEMETRY telemetry AP gateway.
JOG_MOBILE_BIND=10.42.0.1
JOG_MOBILE_PORT=8443

# Self-signed certificate for the bind address (public cert + root-only key).
JOG_MOBILE_TLS_CERT=/etc/jog/mobile-cert.pem
JOG_MOBILE_TLS_KEY=/etc/jog/mobile-key.pem

# Local JOG APIs (already bound to localhost by their own services).
JOG_IMAGING_URL=http://127.0.0.1:8088
JOG_MODEL_URL=http://127.0.0.1:8089

# Interfaces / paths used by the overview and doctor checks.
JOG_AP_INTERFACE=wlxd037450adc29
JOG_IMAGING_NIC=enp2s0
JOG_IMAGING_PATH=/images
JOG_STORAGE_PATHS=/,/images
