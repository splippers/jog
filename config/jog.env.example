# Copy to /etc/jog/jog.env and edit. Used by jog-render-dnsmasq.sh and kiosk scripts.

# --- Imaging (USB3 Ethernet only) ---
# Interface name for the USB NIC (use: ip -br link)
# Example: enx00e04c680001
JOG_USB_IFACE=enxREPLACE_ME

# Static address on the imaging link (must match dhcp-range subnet below)
JOG_IMAGING_IP=10.99.0.1
JOG_IMAGING_PREFIX=24

# DHCP pool served ONLY on JOG_USB_IFACE
JOG_DHCP_START=10.99.0.100
JOG_DHCP_END=10.99.0.200
JOG_DHCP_NETMASK=255.255.255.0
JOG_DHCP_LEASE_HOURS=12

# Handed to PXE clients as default gateway (usually the JOG laptop on this link)
JOG_DHCP_ROUTER=10.99.0.1

# TFTP / NEXT SERVER (siaddr) — must match the FOG server IP clients use for PXE TFTP
JOG_NEXT_SERVER=10.99.0.1

# PXE boot file served via TFTP (relative to tftpboot root). Default is the signed shim so Secure Boot
# machines can boot JOS. snponly.efi (FOG's iPXE) is unsigned and only works with Secure Boot OFF.
JOG_DHCP_BOOTFILE=ubuntu-signed/shimx64.efi

# --- WiFi / updates (optional; for documentation in netplan snippet) ---
# JOG does not manage WiFi; keep a normal NetworkManager/netplan profile with lower
# metric than the imaging link so default route + DNS stay on WiFi for apt pulls.

# --- FOG / kiosk (FOG runs natively under /opt/fog; Apache on port 80) ---
# First Chromium tab on login (after graphical autologin — see docs/ISO-BUILD.md).
JOG_FOG_URL=http://localhost/fog/management/

# Optional extra tab if different from JOG_FOG_URL (e.g. specific task list)
JOG_FOG_TASKS_URL=

# Local status page (file://) generated by jog-refresh-status.service
JOG_STATUS_URL=file:///var/lib/jog/status/index.html

# Live imaging view (first kiosk tab). Needs /etc/jog/fog-api.env; empty = omit the tab.
JOG_IMAGING_URL=http://127.0.0.1:8088/

# Chromium kiosk: auto-restart if the browser exits (default 1). Set 0 to disable loop.
JOG_CHROMIUM_RESTART=1

# Optional extra Chromium flags (quoted string, split on spaces — advanced)
# JOG_CHROMIUM_EXTRA_FLAGS=

# --- Corporate driver share (Samba) ---
# Run: sudo jog-driver-share.sh --apply  (or set JOG_DRIVER_SHARE_ENABLE=1 and use jog-provision-stack.sh)
JOG_DRIVER_SHARE_ENABLE=0
JOG_DRIVER_SHARE_NAME=Drivers
JOG_DRIVER_SHARE_PATH=/srv/jog/drivers
JOG_DRIVER_READ_USER=drivers
JOG_DRIVER_WRITE_USER=driveradmin
JOG_DRIVER_ALLOW_GUEST=0
# UNC used by the Windows provisioner. Single quotes keep the backslashes literal.
JOG_DRIVER_SHARE_UNC='\\10.99.0.1\Drivers'

# --- Driver model API (read-only FOG inventory for Sync-FOGDriverPacks.ps1) ---
# Run: sudo jog-model-api-setup.sh --apply  (or let post-FOG setup do it)
JOG_MODEL_API_ENABLE=1

# --- JOS multicast auto-join (default PXE entry) ---
# Installs /fog/service/jog-autojoin.php. When a registered host PXE boots the
# default JOS entry and a multicast session is still in its join window, JOS
# creates the per-host multicast association automatically. No menu selection
# or FOG login on the client. If nothing is waiting, JOS boots the local disk.
# Run: sudo jog-autojoin-setup.sh --apply  (or let post-FOG setup do it)
JOG_AUTOJOIN_ENABLE=1
# Comma-separated CIDRs allowed to call the endpoint. Defaults to the imaging
# network derived from JOG_IMAGING_IP/JOG_IMAGING_PREFIX (10.99.0.0/24).
# JOG_AUTOJOIN_ALLOW_NET=10.99.0.0/24

# --- Multicast profile (100-client reference design; see docs/MULTICAST-100.md) ---
# Run: sudo jog-multicast-tune.sh --check  then  --apply
JOG_MULTICAST_TUNE=0
JOG_MULTICAST_MAX_CLIENTS=100
JOG_MULTICAST_BITRATE=800m
JOG_MULTICAST_MAXWAIT_MIN=3
JOG_MULTICAST_MAX_SESSIONS=64
# Optional. Defaults to the IPv4 address on JOG_USB_IFACE. It must match the
# address the FOS client uses for $storageip; on the lab appliance this is
# 10.99.0.1 for enp2s0, not 192.168.254.1.
# JOG_MULTICAST_RENDEZVOUS=10.99.0.1

# --- JOS kernel command line extras ---
# Appended to every JOS kernel line by the staging script (space-separated, no quotes).
# Example for the legacy watchdog: JOS_UDPCAST_MIN_MB_S=80 JOS_UDPCAST_STRIKES=2
JOG_JOS_CMDLINE_EXTRA=

# --- Corporate provisioning payload ---
# Run: sudo jog-corporate-setup.sh  (writes /etc/jog/provisioning.env, installs the payload)
JOG_PROVISIONING_ENABLE=0
