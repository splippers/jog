# /etc/jog/provisioning.env — corporate provisioning configuration
#
# Copy to /etc/jog/provisioning.env (mode 0600) and edit, or run:
#   sudo jog-corporate-setup.sh
#
# This file is read by jog-install-provisioner.sh, which renders
# /images/postdownloadscripts/jog-provisioner/jog-provisioning.json.
#
# NEVER commit a real password. The example uses CHANGE_ME placeholders.

# --- Identity ---
JOG_SITE_CODE=SITE01
JOG_ORG_NAME="Example Corporation"
JOG_DEVICE_NAME_PATTERN='LT-{Site}-{Serial}'

# --- Domain ---
JOG_DOMAIN=corp.example.com
JOG_DOMAIN_NETBIOS=CORP
# Credential is the default for the current fleet payload: one djoin blob joins
# one computer account, so a single blob cannot be reused across a room.
# Use Offline only for a single device, or when you generate a per-device blob.
# Offline | Credential
JOG_DOMAIN_JOIN_MODE=Credential
JOG_DOMAIN_JOIN_OU='OU=Workstations,OU=JOG,DC=corp,DC=example,DC=com'
# Credential mode only. Use a dedicated, delegated, time-limited account.
JOG_DOMAIN_JOIN_USER=
JOG_DOMAIN_JOIN_PASSWORD=
# Offline mode: path to the djoin blob. jog-install-provisioner.sh copies it
# into the payload. A blob is tied to one computer name/account: do not deploy
# the same payload to more than one device in Offline mode.
JOG_DOMAIN_JOIN_BLOB=

# --- Entra hybrid join ---
JOG_HYBRID_JOIN=1
JOG_HYBRID_JOIN_TIMEOUT_MIN=30

# --- AD groups (comma-separated, no spaces) ---
JOG_AD_GROUPS='JOG-Workstations,EndpointProtection,DeviceEncryption'
# Credential mode: the join account must be delegated to add members.
# Offline mode: use Add-JOGComputerGroups.ps1 from a management host.
JOG_GROUPS_MODE=Device

# --- BitLocker ---
JOG_BITLOCKER_ENABLED=1
# TpmOnly (recommended) | TpmPin
JOG_BITLOCKER_MODE=TpmOnly
JOG_BITLOCKER_PIN_LENGTH=6
# AD | Entra | Both | None
JOG_BITLOCKER_ESCROW=AD
# None (recommended) | LocalDPAPI | ADCustomAttribute (not recommended)
JOG_BITLOCKER_PIN_STORAGE=None
# Must be true before ADCustomAttribute is allowed.
JOG_BITLOCKER_ALLOW_AD_PIN_STORAGE=0
JOG_BITLOCKER_AD_PIN_ATTRIBUTE=extensionAttribute15

# --- Driver share ---
# The read-only account is created by jog-driver-share.sh. Leave the password
# blank to let jog-install-provisioner.sh read /etc/jog/driver-share.env.
JOG_DRIVER_SHARE_UNC='\\10.99.0.1\Drivers'
JOG_DRIVER_READ_USER=drivers
JOG_DRIVER_READ_PASSWORD=
# Optional JSON object mapping model substrings to folder names, e.g.
# {"Latitude 3440":"Latitude-3440","Latitude 5450":"Latitude-5450"}
JOG_DRIVER_MODEL_MAP='{}'
JOG_DRIVER_FALLBACK=Default
# Always install this storage base pack before the model pack. The sync script
# publishes VMD/iaStorVD here; a RAID image can boot but still need the driver.
JOG_DRIVER_BASE_PACKS='VMD'
JOG_DRIVER_MANIFEST=manifest.json

# --- Behaviour ---
# AirGapped: stop after drivers + hostname and leave a desktop handoff shortcut.
#            Corporate join, hybrid join, groups, BitLocker, and escrow run
#            later from Resume-JOGCorporateEnrollment.ps1 on the corporate LAN.
# Connected: run the full pipeline immediately (only for devices that can reach
#            a domain controller and Entra during imaging).
JOG_PROVISIONING_MODE=AirGapped
JOG_PROVISIONING_REBOOT_BETWEEN_STAGES=1
JOG_PROVISIONING_SHUTDOWN_ON_COMPLETE=0
JOG_PROVISIONING_MAX_ATTEMPTS=5
JOG_PROVISIONING_DELETE_CONFIG_ON_COMPLETE=1
