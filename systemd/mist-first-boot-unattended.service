[Unit]
Description=Brume unattended first-boot (Hyper-V / single-NIC lab)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/mist/unattended.active

[Service]
Type=oneshot
ExecStart=/usr/local/bin/mist-first-boot-unattended.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
