[Unit]
Description=Haar control portal (local API + kiosk UI)
After=network-online.target apache2.service
Wants=network-online.target

[Service]
Type=simple
User=jog
Group=jog
LoadCredential=fog-api.env:/etc/jog/fog-api.env
Environment=JOG_FOG_API_ENV=%d/fog-api.env
Environment=JOG_ENV_FILE=/etc/jog/jog.env
Environment=JOG_IMAGING_STATIC=/usr/local/share/jog/imaging
Environment=JOG_PORTAL_HELPER=/usr/local/sbin/jog-portal-network.sh
ExecStart=/usr/local/bin/jog-imaging-api.py
Restart=on-failure
RestartSec=3
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
