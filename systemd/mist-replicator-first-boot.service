[Unit]
Description=MIST replicator first boot specialization
ConditionPathExists=/etc/mist/replicator.generic
After=network-online.target systemd-user-sessions.service
Wants=network-online.target
Before=getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/mist-replicator-first-boot.sh
StandardInput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=no
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
