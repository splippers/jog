[Unit]
Description=Haaremetry mobile companion API
After=network-online.target jog-jogemetry-hotspot.service jog-jogemetry-dnsmasq.service
Wants=network-online.target jog-jogemetry-hotspot.service jog-jogemetry-dnsmasq.service

[Service]
Type=simple
User=root
Group=root
Environment=JOG_MOBILE_ENV=/etc/jog/mobile-api.env
WorkingDirectory=/usr/local/lib/jogemetry
ExecStart=/usr/bin/python3 /usr/local/lib/jogemetry/jog-mobile-api.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
