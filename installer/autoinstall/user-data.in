#cloud-config
# Brume autoinstall target: Ubuntu Server 26.04 LTS (Subiquity) amd64 live-server ISO
# + CIDATA seed ISO (see docs/ISO-BUILD.md).
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  refresh-installer:
    update: false
  identity:
    hostname: haar-base
    username: jogadmin
    password: '@PASSWORD@'
  ssh:
    install-server: true
    allow-pw: true
  network:
    network:
      version: 2
      ethernets: {}
  storage:
    layout:
      name: direct
  packages:
    - dialog
    - dnsmasq
    - git
    - curl
    - openssl
    - python3
    - cabextract
    - samba
    - smbclient
    - ethtool
  late-commands:
    - curtin in-target --target=/target -- bash -lc 'git clone https://github.com/splippers/Brume.git /opt/Brume || (cd /opt/Brume && git pull || true)'
    - curtin in-target --target=/target -- install -m 0755 /opt/Brume/installer/haar-install-wizard.sh /usr/local/sbin/haar-install-wizard.sh
    - curtin in-target --target=/target -- install -m 0644 /opt/Brume/installer/motd/haar-remind.sh /etc/profile.d/haar-remind.sh
    - curtin in-target --target=/target -- env Brume_SKIP_SYSTEMD=1 bash /opt/Brume/install/haar-install.sh || true
